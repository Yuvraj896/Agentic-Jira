# Copy this file to .env in the repository root.
# Personal Jira tokens are entered in the UI and must never be stored here.

# Jira Data Center. Change the URL only if your organization uses another
# instance. Prefer true for SSL verification; the RADCOM prototype currently
# defaults to false because the internal certificate may not be locally trusted.
JIRA_BASE_URL=https://jira-prod.radcom.co.il:8443
JIRA_VERIFY_SSL=false
JIRA_TIMEOUT_SECONDS=30

# Local LLM used only by Ask Jira. Manual JQL works without Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Team mapping and safe agent limits. Relative paths start at the repo root.
TEAMS_CONFIG=teams.yaml
SESSION_TTL_SECONDS=28800
AGENT_MAX_TOOL_CALLS=3
AGENT_SUMMARY_ISSUE_LIMIT=50

# Browser settings. Keep COOKIE_SECURE=false for localhost HTTP; use true only
# behind HTTPS. Add origins here only when running the UI on another address.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
